; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GDScriptTemplate"
run/main_scene="uid://1m8pq1aii7xv"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.06469657, 0.06469652, 0.0646965, 1)
config/icon="uid://vnjl0l0d0qw6"

[autoload]

PlayerPrefs="*uid://ybfjx38p6i0s"
GameSettings="*uid://bgwwxsdschogc"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_audio_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red",
"res://assets/": "orange",
"res://prefabs/": "yellow",
"res://scenes/": "green",
"res://scripts/": "teal"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
